PORT=3000

# Clé secrète statique partagée avec le client Python (générer : openssl rand -hex 32)
MAIL_SERVICE_API_KEY=change-me

# Expéditeur
FROM_NAME=ENI Mail
FROM_EMAIL=no-reply@example.com

# Option 1 : API HTTPS Brevo (prioritaire si définie, utile si le port SMTP est bloqué)
BREVO_API_KEY=

# Option 2 : SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
